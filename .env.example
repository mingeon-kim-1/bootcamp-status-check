# Database (PostgreSQL). Use Vercel Postgres or any Postgres instance.
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/database?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/database"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public display view (optional). When set, /{locale}/view?token=YOUR_SECRET shows the status grid without login.
DISPLAY_PUBLIC_TOKEN="optional-secret-for-view-url"
